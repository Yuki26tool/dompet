# Salin jadi .env (atau export manual). File .env JANGAN di-commit.
# Contoh: cp .env.example .env

# Port server (default: 8099)
PORT=8110

# Lokasi database sqlite sync (default: /var/minis/shared/dompet/sync.db)
DOMPET_DB=/var/minis/shared/dompet/sync.db

# Root file statis app (default: folder induk server/)
# DOMPET_ROOT=/path/ke/dompet

# Dipakai online.sh
# DOMPET_LOG=/tmp/dompet-online.log
